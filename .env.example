# ============ Mindex 配置（全部可选，有合理默认值）============
# 复制为 .env 后按需修改。服务器启动时自动读取。

# ---- 服务 ----
# 监听地址：本机用 127.0.0.1；部署到服务器对外提供服务时改为 0.0.0.0
MINDEX_HOST=127.0.0.1
MINDEX_PORT=8787

# 管理界面登录 Token。不设置则首次启动自动生成，
# 打印在控制台并保存到 data/.admin_token
# MINDEX_ADMIN_TOKEN=

# 数据目录（SQLite 数据库 + 原始抓取快照）
# MINDEX_DATA_DIR=./data

# ---- LLM（研究 Agent 的规划/抽取/冲突判定）----
# 推荐用管理界面「设置」页配置（保存即生效、无需重启、可测试连接、密钥脱敏）。
# 以下 env 仍可用，优先级：设置页 > .env > 默认值。
# auto（默认）: Anthropic Key → OpenAI Key → 本机 claude CLI → 降级为启发式抽取。
# 可选值: auto | anthropic | openai | claude-cli | none
MINDEX_LLM_PROVIDER=auto

# Anthropic API（质量最好）
# ANTHROPIC_API_KEY=sk-ant-...
# MINDEX_ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI 或任意 OpenAI 兼容端点（DeepSeek / MiniMax / Qwen / 本地 Ollama/LM Studio / 网关）
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1      # 兼容平台填其地址，如 https://api.deepseek.com/v1
# MINDEX_OPENAI_MODEL=gpt-4o-mini                # 按平台填：deepseek-chat / qwen-plus 等

# claude CLI 模式使用的模型（本机已登录 Claude Code 即可用，零额外凭证）
# MINDEX_CLAUDE_CLI_MODEL=haiku

# ---- 抓取 ----
# robots.txt 策略: strict=禁止项跳过 | log=抓取但记录状态（默认）| off=不检查
MINDEX_ROBOTS_POLICY=log
# 每主机默认限速（次/分钟）；itunes.apple.com 内置更严格的 10/min 覆盖
MINDEX_FETCH_RPM=30
# 对外抓取时的 User-Agent 标识
# MINDEX_USER_AGENT=MindexResearchBot/0.1 (+https://your-domain; contact you@example.com)

# ---- 代理 ----
# 抓取层遵循 http_proxy/https_proxy 环境变量（npm scripts 已内置 NODE_USE_ENV_PROXY=1）。
# 如果你的网络访问 Wikipedia/App Store 需要代理，确保 shell 中已导出这些变量。

# ---- 抱抱米复用（可选连接器）----
# 抱抱米（baobaomi）是已在采集抖音/B站/TapTap 内容的配套服务，暴露 Agent API。
# 配置后，Mindex 会把它的热点趋势/爆量素材作为原始来源接入，经自身溯源与置信度管线转化为可信知识。
# 不配置则该连接器显示 needs_key 并跳过（不影响其他来源）。
# BAOBAOMI_BASE_URL=https://baobaomi.fun   # 或走内网 http://10.66.67.1（需带 Host: baobaomi.fun）
# BAOBAOMI_AGENT_KEY=                       # 抱抱米 config 表中的 agent_api_key

# ---- Bilibili 连接器（可选）----
# 通过 bili CLI 取游戏相关高播放视频的热评作玩家反馈（免登录）。
# 需先安装：pip install bilibili-cli（或 uv tool install bilibili-cli）。
# 连接器自动探测 bili；如不在 PATH 上用 BILI_CLI_PATH 指定。
# 注意：bili 走 api.bilibili.com，若你的网络需代理，确保服务进程能读到 http_proxy/https_proxy。
# BILI_CLI_PATH=/Users/you/.local/bin/bili
# BILI_MAX_VIDEOS=10

# ---- TikHub 集成（可选，供小红书连接器）----
# TikHub（https://tikhub.io）是付费多平台 API 聚合器，为「小红书口碑」连接器供数
# （也覆盖微博/知乎/快手等，未来可扩展）。推荐用「设置」页配置（可测试连接）。
# TIKHUB_BASE_URL=https://api.tikhub.io
# TIKHUB_API_KEY=                          # TikHub 控制台的 API Key
# XHS_MAX_NOTES=8                           # 每次研究抓取的小红书笔记数上限
